# Control plane
TANDEMESH_LISTEN=:8080
TANDEMESH_BASE_URL=http://localhost:8080
TANDEMESH_DB_PATH=tandemesh.db
# Postgres: TANDEMESH_DB_PATH=postgres://orca:orca@localhost:5432/orca?sslmode=disable
TANDEMESH_JOIN_TOKEN=change-me
TANDEMESH_AGENTD_DIR=bin/agents
# Optional JSON override for the built-in skill marketplace catalog.
TANDEMESH_SKILL_MARKET_FILE=
TANDEMESH_SKILL_MARKET_URL=
# Comma-separated GitHub repositories to scan for SKILL.md files.
TANDEMESH_SKILL_MARKET_REPOS=
TANDEMESH_GITHUB_SECRET=
TANDEMESH_LEASE_TTL=30s
TANDEMESH_RUN_TIMEOUT=30m
TANDEMESH_MAX_ATTEMPTS=3
TANDEMESH_TELEMETRY=off

# OAuth refresh (optional, for expiring tokens)
# TANDEMESH_LINEAR_CLIENT_ID=
# TANDEMESH_LINEAR_CLIENT_SECRET=
# TANDEMESH_JIRA_CLIENT_ID=
# TANDEMESH_JIRA_CLIENT_SECRET=
# TANDEMESH_GRAPH_CLIENT_ID=
# TANDEMESH_GRAPH_CLIENT_SECRET=

# TANDEMESH_SESSION_KEY=
# TANDEMESH_ALLOW_HEADER_AUTH=on

# Machine daemon
TANDEMESH_PLANE_URL=http://127.0.0.1:8080
# The join token is passed explicitly: `tandemesh-agentd -token ...` or TANDEMESH_JOIN_TOKEN.
