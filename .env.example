# Control plane
ORCA_LISTEN=:8080
ORCA_BASE_URL=http://localhost:8080
ORCA_DB_PATH=orca.db
# Postgres: ORCA_DB_PATH=postgres://orca:orca@localhost:5432/orca?sslmode=disable
ORCA_JOIN_TOKEN=change-me
ORCA_AGENTD_DIR=bin/agents
# Optional JSON override for the built-in skill marketplace catalog.
ORCA_SKILL_MARKET_FILE=
ORCA_SKILL_MARKET_URL=
# Comma-separated GitHub repositories to scan for SKILL.md files.
ORCA_SKILL_MARKET_REPOS=
ORCA_GITHUB_SECRET=
ORCA_LEASE_TTL=30s
ORCA_RUN_TIMEOUT=30m
ORCA_MAX_ATTEMPTS=3
ORCA_TELEMETRY=off

# OAuth refresh (optional, for expiring tokens)
# ORCA_LINEAR_CLIENT_ID=
# ORCA_LINEAR_CLIENT_SECRET=
# ORCA_JIRA_CLIENT_ID=
# ORCA_JIRA_CLIENT_SECRET=
# ORCA_GRAPH_CLIENT_ID=
# ORCA_GRAPH_CLIENT_SECRET=

# ORCA_SESSION_KEY=
# ORCA_ALLOW_HEADER_AUTH=on

# Machine daemon
ORCA_PLANE_URL=http://127.0.0.1:8080
# The join token is passed explicitly: `tandemesh-agentd -token ...` or ORCA_JOIN_TOKEN.
