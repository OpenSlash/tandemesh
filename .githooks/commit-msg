#!/bin/sh
# Enforce Conventional Commits for this repository.
# Install with: git config core.hooksPath .githooks

msg_file="$1"
subject=$(head -n 1 "$msg_file")

case "$subject" in
  Merge*|Revert*|fixup!*|squash!*)
    exit 0
    ;;
esac

pattern='^(feat|fix|refactor|perf|test|docs|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit message rejected:" >&2
  echo "  $subject" >&2
  echo "" >&2
  echo "Use: <type>(<scope>): <imperative summary>" >&2
  echo "Types: feat fix refactor perf test docs build ci chore revert" >&2
  echo "Subject must be 72 characters or less." >&2
  exit 1
fi

exit 0
